{
  "name": "IEEE Transactions on Dependable and Secure Computing Guidelines",
  "journalTitle": "IEEE Transactions on Dependable and Secure Computing",
  "journalIssn": "1545-5971",
  "sourceUrl": "https://www.computer.org/csdl/journal/tq/write-for-us/15048",
  "schemaVersion": 1,
  "rules": {
    "schemaVersion": 1,
    "general": {
      "maxWords": 9500,
      "minWords": 3000,
      "wordLimitExcludes": [
        "references",
        "figureCaptions",
        "appendices"
      ],
      "maxAbstractWords": 200,
      "abstractStructure": "unstructured",
      "keywords": {
        "min": 3,
        "max": 5
      },
      "keywordSeparator": "comma",
      "maxTitleChars": 150,
      "requiredSections": [
        "Abstract",
        "Keywords",
        "Introduction",
        "Methods",
        "Results",
        "Discussion",
        "Conclusion",
        "Acknowledgements",
        "References"
      ],
      "requiredStatements": [
        "conflictOfInterest",
        "dataAvailability",
        "funding",
        "authorContributions",
        "generativeAI",
        "acknowledgements"
      ]
    },
    "citation": {
      "style": "IEEE",
      "numbered": true,
      "maxReferences": 55,
      "notes": "IEEE numbered citations in square brackets [1] ordered by appearance."
    },
    "layout": {
      "columns": "double",
      "pageSize": "Letter",
      "fontFamily": "Times New Roman",
      "fontSizePt": 10.0,
      "fontSizeTitlePt": 24.0,
      "fontSizeFigureCaptionPt": 8.0,
      "fontSizeTableCaptionPt": 8.0,
      "documentClass": "IEEEtran.cls",
      "lineSpacing": 1.0,
      "marginsCm": {
        "top": 1.9,
        "bottom": 2.54,
        "left": 1.6,
        "right": 1.6
      },
      "maxPages": 14
    },
    "figures": {
      "maxFigures": 12,
      "maxTables": 6,
      "formats": [
        "pdf",
        "eps",
        "tiff",
        "png"
      ],
      "minDpi": 300
    },
    "submission": {
      "fileFormats": [
        "pdf",
        "tex",
        "docx"
      ],
      "reviewType": "single_blind",
      "templateUrl": "https://template-selector.ieee.org/",
      "coverLetterRequired": true,
      "highlightsRequired": false,
      "orcidRequired": true
    },
    "articleTypes": [
      {
        "name": "Regular Paper",
        "maxWords": 9500,
        "maxAbstractWords": 200,
        "requiredSections": [
          "Introduction",
          "Methods",
          "Results",
          "Discussion",
          "Conclusion",
          "References"
        ],
        "maxFigures": 12,
        "maxTables": 6,
        "maxReferences": 55
      },
      {
        "name": "Short Paper",
        "maxWords": 4500,
        "maxAbstractWords": 150,
        "requiredSections": [
          "Introduction",
          "Methods",
          "Results",
          "Conclusion",
          "References"
        ],
        "maxFigures": 6,
        "maxTables": 3,
        "maxReferences": 30
      },
      {
        "name": "Survey Paper",
        "maxWords": 12000,
        "maxAbstractWords": 250,
        "requiredSections": [
          "Introduction",
          "Background",
          "Discussion",
          "Conclusion",
          "References"
        ],
        "maxFigures": 14,
        "maxTables": 8,
        "maxReferences": 100
      }
    ],
    "defaultArticleType": "Regular Paper"
  }
}