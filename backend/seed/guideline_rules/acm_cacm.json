{
  "name": "Communications of the ACM (CACM) Guidelines",
  "journalTitle": "Communications of the ACM (CACM)",
  "journalIssn": "0001-0782",
  "sourceUrl": "https://cacm.acm.org/author-guidelines/",
  "schemaVersion": 1,
  "rules": {
    "schemaVersion": 1,
    "general": {
      "maxWords": 4500,
      "minWords": 3000,
      "wordLimitExcludes": [
        "references",
        "appendices"
      ],
      "maxAbstractWords": 150,
      "abstractStructure": "unstructured",
      "keywords": {
        "min": 3,
        "max": 8
      },
      "keywordSeparator": "comma",
      "maxTitleChars": 160,
      "requiredSections": [
        "Abstract",
        "Keywords",
        "Introduction",
        "Methods",
        "Results",
        "Discussion",
        "Conclusion",
        "References"
      ],
      "requiredStatements": [
        "conflictOfInterest",
        "dataAvailability",
        "funding",
        "authorContributions",
        "generativeAI",
        "acknowledgements"
      ]
    },
    "citation": {
      "style": "ACM",
      "numbered": true,
      "maxReferences": 25,
      "notes": "ACM-Reference-Format numbered citations in square brackets."
    },
    "layout": {
      "columns": "double",
      "pageSize": "Letter",
      "fontFamily": "Linux Libertine",
      "fontSizePt": 10.0,
      "fontSizeTitlePt": 14.0,
      "fontSizeFigureCaptionPt": 9.0,
      "fontSizeTableCaptionPt": 9.0,
      "documentClass": "acmart.cls",
      "lineSpacing": 1.0,
      "marginsCm": {
        "top": 2.54,
        "bottom": 2.54,
        "left": 2.2,
        "right": 2.2
      },
      "maxPages": 8
    },
    "figures": {
      "maxFigures": 12,
      "maxTables": 8,
      "formats": [
        "pdf",
        "png",
        "eps",
        "svg"
      ],
      "minDpi": 300
    },
    "submission": {
      "fileFormats": [
        "tex",
        "pdf",
        "docx"
      ],
      "reviewType": "single_blind",
      "templateUrl": "https://www.acm.org/publications/proceedings-template",
      "coverLetterRequired": true,
      "highlightsRequired": false,
      "orcidRequired": true
    },
    "articleTypes": [
      {
        "name": "Research Article",
        "maxWords": 4500,
        "maxAbstractWords": 150,
        "requiredSections": [
          "Introduction",
          "Methods",
          "Results",
          "Discussion",
          "Conclusion",
          "References"
        ],
        "maxFigures": 12,
        "maxTables": 8,
        "maxReferences": 25
      },
      {
        "name": "Short Paper",
        "maxWords": 5000,
        "maxAbstractWords": 150,
        "requiredSections": [
          "Introduction",
          "Methods",
          "Results",
          "Conclusion",
          "References"
        ],
        "maxFigures": 6,
        "maxTables": 4,
        "maxReferences": 35
      },
      {
        "name": "Tutorial and Survey",
        "maxWords": 18000,
        "maxAbstractWords": 250,
        "requiredSections": [
          "Introduction",
          "Background",
          "Discussion",
          "Conclusion",
          "References"
        ],
        "maxFigures": 15,
        "maxTables": 10,
        "maxReferences": 160
      }
    ],
    "defaultArticleType": "Research Article"
  }
}